{
  "_설명": "매일 아침 Power BI에서 불러올 데이터 목록. dataset_id는 Power BI 데이터셋 URL에서 확인. workspace_id는 '내 작업 영역'이면 비워두고, 특정 작업 영역이면 그룹 ID 입력.",
  "queries": [
    {
      "name": "일별 매출",
      "description": "최근 30일 일별 매출 추이",
      "workspace_id": "",
      "dataset_id": "YOUR-DATASET-ID",
      "dax": "EVALUATE TOPN(30, SUMMARIZECOLUMNS('Date'[Date], \"매출\", SUM(Sales[Amount])), 'Date'[Date], DESC)"
    },
    {
      "name": "제품별 실적",
      "description": "제품 카테고리별 매출/수량",
      "workspace_id": "",
      "dataset_id": "YOUR-DATASET-ID",
      "dax": "EVALUATE SUMMARIZECOLUMNS(Product[Category], \"매출\", SUM(Sales[Amount]), \"수량\", SUM(Sales[Qty]))"
    }
  ]
}

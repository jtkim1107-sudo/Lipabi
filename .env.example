# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# 분석에 사용할 모델 (기본: claude-opus-5)
ANALYSIS_MODEL=claude-opus-5

# ── Power BI (Azure AD 서비스 주체) ─────────────────────────
# Azure Portal > 앱 등록에서 발급
POWERBI_TENANT_ID=your-tenant-id
POWERBI_CLIENT_ID=your-client-id
POWERBI_CLIENT_SECRET=your-client-secret

# Power BI 연동 없이 샘플 데이터로 먼저 체험하려면 true
POWERBI_MOCK=true

# ── 스케줄 / 자동화 ─────────────────────────────────────────
# 매일 아침 자동 분석 시각 (Asia/Seoul, HH:MM)
DAILY_RUN_TIME=07:00
TIMEZONE=Asia/Seoul
# 분석 직후 전 직원 브리핑 자동 생성 (false로 끄면 직원이 열 때 생성)
AUTO_BRIEFINGS=true
# 주간 자동 학습 (요일 시:분). 비우면 비활성화
WEEKLY_TRAIN=mon 06:30
# 자기 채점: 어제 인사이트를 오늘 데이터로 매일 검증
SELF_REVIEW=true
# 저녁 업무 보고 자동 생성 시각 (HH:MM). 비우면 비활성화
DAILY_REPORT_TIME=18:00

# ── 로그인/보안 ─────────────────────────────────────────────
# 최초 실행 시 자동 생성되는 관리자 계정
ADMIN_USERNAME=admin
ADMIN_NAME=관리자
# 비워두면 최초 실행 시 임시 비밀번호가 무작위 생성되어 서버 로그에 출력됩니다
ADMIN_PASSWORD=

# 로그인 유지 기간 (일)
SESSION_DAYS=14
# HTTPS(리버스 프록시 등)로 서비스하면 true 권장
COOKIE_SECURE=false

# ── 서버 ────────────────────────────────────────────────────
# POST /api/run 을 외부(GitHub Actions 등)에서 호출할 때 쓰는 토큰
RUN_TOKEN=change-me

# SQLite 데이터베이스 경로
DB_PATH=data/lipabi.db
